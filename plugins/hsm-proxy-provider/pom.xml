<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.gematik.zeta.zeta-guard</groupId>
        <artifactId>keycloak-zeta</artifactId>
        <version>1.3.2</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>hsm-proxy-provider</artifactId>
    <name>𝝵-Guard :: HSM Proxy Security Provider (shaded JAR)</name>
    <description>
        Shaded fat JAR of java-hsm-proxy-provider + gRPC/guava/protobuf/SLF4J, relocated to
        de.gematik.zetaguard.shaded.* to coexist with Keycloak's own copies. The jar ships to
        providers/ (so kc.sh build sees it) and is also added to the JVM bootstrap classpath
        by startup.sh (so security.provider.2=HSMPROXY resolves at JVM init).
    </description>

    <dependencies>
        <dependency>
            <groupId>de.gematik.zeta.zeta-guard</groupId>
            <artifactId>java-hsm-proxy-provider</artifactId>
            <version>${java-hsm-proxy-provider.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Attach as classifier so the main (unshaded) JAR stays primary
                                 — keeps JaCoCo report-aggregate scoped to this module's classes. -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>fat</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Preserve META-INF/services entries (gRPC NameResolver/LoadBalancer,
                                     java.security.Provider) instead of last-one-wins. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.keycloak:*</exclude>
                                    <exclude>io.quarkus:*</exclude>
                                    <exclude>jakarta.*:*</exclude>
                                    <!-- Keycloak ships an identical org.jspecify:1.0.0 in lib/lib/main/. -->
                                    <exclude>org.jspecify:*</exclude>
                                </excludes>
                            </artifactSet>
                            <!-- Relocate bundled libs to a private package so they don't collide with
                                 Keycloak's own copies in lib/lib/main/ (protobuf 4.x, grpc 1.79.x,
                                 guava 33.x, etc.). Bytecode rewrite, same pattern as grpc-netty-shaded. -->
                            <relocations>
                                <!-- Deliberately broad: covers protobuf, guava, errorprone, gson, j2objc, etc.
                                     Narrowing risks missing a transitive and reintroducing classloader conflicts. -->
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.grpc</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.grpc</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.perfmark</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.perfmark</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>android.annotation</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.android.annotation</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.annotation</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.jsr305</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.codehaus.mojo.animal_sniffer</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.animalsniffer</shadedPattern>
                                </relocation>
                                <!-- SLF4J: bundled+relocated (no binding inside) → HSM-proxy internal
                                     logs go to NOPLogger; Keycloak's SLF4J in lib/lib/main/ is untouched. -->
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.slf4j</shadedPattern>
                                </relocation>
                                <!-- java-hsm-proxy-provider ships as a fat jar embedding the Kotlin stdlib;
                                     relocate it so kotlin.* doesn't split-package with providers/kotlin-stdlib. -->
                                <relocation>
                                    <pattern>kotlin</pattern>
                                    <shadedPattern>de.gematik.zetaguard.shaded.kotlin</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
