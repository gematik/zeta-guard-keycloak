<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.gematik.zeta.zeta-guard</groupId>
        <artifactId>keycloak-zeta</artifactId>
        <version>1.0.1</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>hsm-proxy-provider</artifactId>
    <name>𝝵-Guard :: HSM Proxy Security Provider (fat JAR)</name>
    <description>
        Fat JAR packaging of java-hsm-proxy-provider and its gRPC/guava/protobuf dependencies.
        Not a Keycloak SPI plugin — just a dependency JAR placed in providers/ for classloading.
        The JCA provider is registered via java.security (security.provider.1) in the Docker image.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.gematik.zeta.zeta-guard</groupId>
            <artifactId>java-hsm-proxy-provider</artifactId>
            <version>${java-hsm-proxy-provider.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Shade plugin produces a self-contained fat JAR that bundles java-hsm-proxy-provider
                and its full gRPC/guava/protobuf transitive runtime dependency tree.
                docker-keycloak only needs to copy this single JAR into providers/.
                Keycloak's own classes (keycloak-*, quarkus, jakarta) are excluded because
                they are already on the Keycloak classloader.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                shadedArtifactAttached=true keeps the original (unshaded) JAR as
                                the main artifact so JaCoCo report-aggregate resolves only this
                                module's own classes. The fat JAR is attached with the classifier
                                below and is what docker-keycloak copies into providers/.
                            -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>fat</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Merge META-INF/services files instead of overwriting.
                                     Without this, gRPC loses its NameResolverProvider (DNS)
                                     and LoadBalancerProvider (pick_first) when multiple gRPC
                                     JARs are shaded into the fat JAR. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.keycloak:*</exclude>
                                    <exclude>io.quarkus:*</exclude>
                                    <exclude>jakarta.*:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
