<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.gematik.zeta.zeta-guard</groupId>
        <artifactId>keycloak-zeta</artifactId>
        <version>1.3.2</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>docker-keycloak-harden</artifactId>
    <name>𝝵-Guard :: Harden Keycloak image</name>
    <description>Downloads patch JARs used to replace vulnerable dependencies in the Keycloak image during the CI harden stage.</description>

    <properties>
        <docker.name>zeta/zeta-guard/keycloak-zeta</docker.name>
        <docker.tag>latest</docker.tag>
        <docker.repo/>
        <docker.image>${docker.name}:${docker.tag}</docker.image>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>

                <executions>
                    <execution>
                        <id>copy-patch-jars</id>
                        <phase>prepare-package</phase>

                        <goals>
                            <goal>copy</goal>
                        </goals>

                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/jars</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>

                            <artifactItems> <!-- Must no be empty, otherwise the plugin will not execute -->
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-codec-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-dns</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-codec-dns-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-haproxy</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-codec-haproxy-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http2</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-codec-http2-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-codec-http-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-handler</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-handler-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-resolver-dns</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-resolver-dns-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-native-epoll</artifactId>
                                    <version>4.1.136.Final</version>
                                    <destFileName>netty-transport-native-epoll-4.1.136.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcpkix-jdk18on</artifactId>
                                    <version>1.85</version>
                                    <destFileName>bcpkix-jdk18on-1.85.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcprov-jdk18on</artifactId>
                                    <version>1.85</version>
                                    <destFileName>bcprov-jdk18on-1.85.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcutil-jdk18on</artifactId>
                                    <version>1.85</version>
                                    <destFileName>bcutil-jdk18on-1.85.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.jkube</groupId>
                <artifactId>kubernetes-maven-plugin</artifactId>
                <version>1.18.1</version>

                <executions>
                    <execution>
                        <id>docker-build</id>
                        <phase>package</phase>

                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <verbose>true</verbose>
                    <logStdout>true</logStdout>
                    <buildStrategy>docker</buildStrategy>

                    <images>
                        <image>
                            <name>${docker.image}</name>

                            <build>
                                <contextDir>${project.build.outputDirectory}</contextDir>
                                <dockerFile>${project.basedir}/Dockerfile</dockerFile>
                            </build>
                        </image>
                    </images>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>gitlab</id>
            <properties>
                <docker.image>${docker.repo}/${docker.name}:${docker.tag}</docker.image>
            </properties>
        </profile>
    </profiles>
</project>
