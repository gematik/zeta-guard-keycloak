<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>de.gematik.zeta.zeta-guard</groupId>
        <artifactId>keycloak-zeta</artifactId>
        <version>2.0.2</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>docker-keycloak-harden</artifactId>
    <name>𝝵-Guard :: Harden Keycloak image</name>
    <description>Downloads patch JARs used to replace vulnerable dependencies in the Keycloak image during the CI harden stage.</description>

    <properties>
        <docker.name>zeta/zeta-guard/keycloak-zeta</docker.name>
        <docker.tag>latest</docker.tag>
        <docker.repo/>
        <docker.image>${docker.name}:${docker.tag}</docker.image>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>

                <executions>
                    <execution>
                        <id>copy-patch-jars</id>
                        <phase>prepare-package</phase>

                        <goals>
                            <goal>copy</goal>
                        </goals>

                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/jars</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>

                            <artifactItems> <!-- Must no be empty, otherwise the plugin will not execute -->
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-codec-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-dns</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-codec-dns-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-haproxy</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-codec-haproxy-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http2</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-codec-http2-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-codec-http-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-handler</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-handler-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-resolver-dns</artifactId>
                                    <version>4.1.139.Final</version>
                                    <destFileName>netty-resolver-dns-4.1.139.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-native-epoll</artifactId>
                                    <version>4.1.139.Final</version>
                                    <classifier>linux-aarch_64</classifier>
                                    <destFileName>netty-transport-native-epoll-4.1.139.Final-linux-aarch_64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-native-epoll</artifactId>
                                    <version>4.1.139.Final</version>
                                    <classifier>linux-x86_64</classifier>
                                    <destFileName>netty-transport-native-epoll-4.1.139.Final-linux-x86_64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcpkix-jdk18on</artifactId>
                                    <version>1.86</version>
                                    <destFileName>bcpkix-jdk18on-1.86.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcprov-jdk18on</artifactId>
                                    <version>1.86</version>
                                    <destFileName>bcprov-jdk18on-1.86.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcutil-jdk18on</artifactId>
                                    <version>1.86</version>
                                    <destFileName>bcutil-jdk18on-1.86.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.mariadb.jdbc</groupId>
                                    <artifactId>mariadb-java-client</artifactId>
                                    <version>3.5.9</version>
                                    <destFileName>mariadb-java-client-3.5.9.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-core-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-databind-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                                    <artifactId>jackson-dataformat-cbor</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-dataformat-cbor-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                                    <artifactId>jackson-dataformat-yaml</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-dataformat-yaml-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jdk8</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-datatype-jdk8-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jsr310</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-datatype-jsr310-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.jakarta.rs</groupId>
                                    <artifactId>jackson-jakarta-rs-base</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-jakarta-rs-base-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.jakarta.rs</groupId>
                                    <artifactId>jackson-jakarta-rs-yaml-provider</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-jakarta-rs-yaml-provider-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.module</groupId>
                                    <artifactId>jackson-module-jakarta-xmlbind-annotations</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-module-jakarta-xmlbind-annotations-2.21.7.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.module</groupId>
                                    <artifactId>jackson-module-parameter-names</artifactId>
                                    <version>2.21.7</version>
                                    <destFileName>jackson-module-parameter-names-2.21.7.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.jkube</groupId>
                <artifactId>kubernetes-maven-plugin</artifactId>
                <version>1.18.1</version>

                <executions>
                    <execution>
                        <id>docker-build</id>
                        <phase>package</phase>

                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <verbose>true</verbose>
                    <logStdout>true</logStdout>
                    <buildStrategy>docker</buildStrategy>

                    <images>
                        <image>
                            <name>${docker.image}</name>

                            <build>
                                <contextDir>${project.build.outputDirectory}</contextDir>
                                <dockerFile>${project.basedir}/Dockerfile</dockerFile>
                            </build>
                        </image>
                    </images>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>gitlab</id>
            <properties>
                <docker.image>${docker.repo}/${docker.name}:${docker.tag}</docker.image>
            </properties>
        </profile>
    </profiles>
</project>
